CREATE TABLE categories(
    _id INTEGER NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    sort INTEGER NOT NULL,
    flags INTEGER NOT NULL,
    content_type INTEGER NOT NULL DEFAULT 0,
    parent_id INTEGER REFERENCES categories(_id) ON DELETE CASCADE
);

-- Insert system category
INSERT OR IGNORE INTO categories(_id, name, sort, flags, content_type, parent_id) VALUES (0, "", -1, 0, 0, NULL);
-- Disallow deletion of default category
CREATE TRIGGER IF NOT EXISTS system_category_delete_trigger BEFORE DELETE
ON categories
BEGIN SELECT CASE
    WHEN old._id <= 0 THEN
        RAISE(ABORT, "System category can't be deleted")
    END;
END;

CREATE TRIGGER IF NOT EXISTS cascade_category_subcategories_delete
BEFORE DELETE ON categories
BEGIN
    DELETE FROM categories WHERE parent_id = old._id;
END;

CREATE INDEX IF NOT EXISTS idx_categories_parent_id ON categories(parent_id);

getCategory:
SELECT *
FROM categories
WHERE _id = :id
LIMIT 1;

getCategories:
SELECT
_id AS id,
name,
sort AS `order`,
flags,
content_type,
parent_id
FROM categories
ORDER BY sort;

getCategoriesByMangaId:
SELECT
C._id AS id,
C.name,
C.sort AS `order`,
C.flags,
C.content_type,
C.parent_id
FROM categories C
JOIN mangas_categories MC
ON C._id = MC.category_id
WHERE MC.manga_id = :mangaId;

-- Batch fetch categories for multiple manga IDs - optimized for duplicate detection
getCategoriesByMangaIds:
SELECT
MC.manga_id,
C._id AS id,
C.name,
C.sort AS `order`,
C.flags,
C.content_type,
C.parent_id
FROM categories C
JOIN mangas_categories MC
ON C._id = MC.category_id
WHERE MC.manga_id IN :mangaIds
ORDER BY MC.manga_id, C.sort;

getCategoriesByContentType:
SELECT
_id AS id,
name,
sort AS `order`,
flags,
content_type,
parent_id
FROM categories
WHERE content_type = :contentType OR content_type = 0
ORDER BY sort;

getSubcategories:
SELECT
_id AS id,
name,
sort AS `order`,
flags,
content_type,
parent_id
FROM categories
WHERE parent_id = :parentId
ORDER BY sort;

getTopLevelCategories:
SELECT
_id AS id,
name,
sort AS `order`,
flags,
content_type,
parent_id
FROM categories
WHERE parent_id IS NULL
ORDER BY sort;

insert:
INSERT INTO categories(name, sort, flags, content_type, parent_id)
VALUES (:name, :order, :flags, :contentType, :parentId);

delete:
DELETE FROM categories
WHERE _id = :categoryId;

deleteOrphanSubcategories:
DELETE FROM categories
WHERE parent_id IS NOT NULL AND parent_id NOT IN (SELECT _id FROM categories);

updateName:
UPDATE categories
SET name = :name
WHERE _id = :categoryId;

updateOrder:
UPDATE categories
SET sort = :order
WHERE _id = :categoryId;

updateParent:
UPDATE categories
SET parent_id = :parentId
WHERE _id = :categoryId;

updateFlags:
UPDATE categories
SET flags = :flags
WHERE _id = :categoryId;

updateAllFlags:
UPDATE categories SET
flags = coalesce(:flags, flags);

selectLastInsertedRowId:
SELECT last_insert_rowid();
