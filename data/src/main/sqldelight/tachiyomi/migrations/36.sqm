-- Add parent_id column for sub-categories
ALTER TABLE categories ADD COLUMN parent_id INTEGER REFERENCES categories(_id) ON DELETE CASCADE;
CREATE INDEX IF NOT EXISTS idx_categories_parent_id ON categories(parent_id);

CREATE TRIGGER IF NOT EXISTS cascade_category_subcategories_delete
BEFORE DELETE ON categories
BEGIN
    DELETE FROM categories WHERE parent_id = old._id;
END;

DELETE FROM categories WHERE parent_id IS NOT NULL AND parent_id NOT IN (SELECT _id FROM categories);
